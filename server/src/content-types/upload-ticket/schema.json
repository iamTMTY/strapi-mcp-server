{
  "kind": "collectionType",
  "collectionName": "mcp_upload_tickets",
  "info": {
    "singularName": "upload-ticket",
    "pluralName": "upload-tickets",
    "displayName": "MCP Upload Ticket"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "ticketHash": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 128,
      "private": true
    },
    "adminUserId": { "type": "string", "required": true, "maxLength": 64 },
    "clientId": { "type": "string", "required": true, "maxLength": 128 },
    "folderId": { "type": "integer" },
    "alternativeText": { "type": "text" },
    "caption": { "type": "text" },
    "used": { "type": "boolean", "default": false, "required": true },
    "expiresAt": { "type": "datetime", "required": true }
  }
}
